# Values must be provided by the deployment environment; no secrets belong in the APK.
DATABASE_URL=postgresql://USER:PASSWORD@MANAGED_POSTGRES_HOST:5432/aurico?sslmode=verify-full
OIDC_ISSUER=https://identity.YOUR_DOMAIN/realms/aurico
OIDC_AUDIENCE=aurico-api
OIDC_CLIENT_ID=aurico-web
OIDC_CLIENT_SECRET=SET_IN_SECRET_MANAGER
WEB_ORIGIN=https://app.YOUR_DOMAIN
ALLOW_LOCAL_HTTP=false
NODE_ENV=production
PORT=4000
